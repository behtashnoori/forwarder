# Production runtime. The app fails fast when required values below are empty,
# placeholder, wildcard, or development/test-only values.
FLASK_ENV=production
FLASK_DEBUG=False

# Required: set to the real production database URL in the deployment secret store.
DATABASE_URL=

# Required: comma-separated real production origins. Wildcard and localhost are rejected.
CORS_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=0

# Required: set both to deployment-specific secrets. Do not commit real values.
SECRET_KEY=
JWT_SECRET_KEY=

# Logging Configuration
LOG_LEVEL=INFO

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
# Migrations must run as an explicit deployment step before backend startup.
AUTO_MIGRATE_ON_STARTUP=false
DB_CONNECT_TIMEOUT_SECONDS=5
