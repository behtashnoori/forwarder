# Database Configuration for Production
DATABASE_URL=postgresql+psycopg2://postgres:${DB_PASSWORD}@db:5432/forwarder_db

# CORS Configuration - تغییر کنید به دامنه واقعی
CORS_ORIGIN=https://yourdomain.com

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Security Configuration - حتماً تغییر دهید!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Logging Configuration
LOG_LEVEL=INFO

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
