# Database Configuration for Production
DATABASE_URL=postgresql+psycopg2://postgres:${DB_PASSWORD}@db:5432/forwarder_db

# CORS Configuration - تغییر کنید به دامنه واقعی
CORS_ORIGIN=https://yourdomain.com
# When frontend is on same server by IP (e.g. http://130.185.77.25:8080), set:
# CORS_ALLOW_IP_ORIGINS=1
# Or: CORS_ORIGINS=http://130.185.77.25:8080

# Flask: listen only on localhost (use behind nginx; set 0.0.0.0 only if needed)
FLASK_RUN_HOST=127.0.0.1
# Flask Configuration (port 5001 to avoid conflict with other app on 5000)
FLASK_RUN_PORT=5001
FLASK_ENV=production
FLASK_DEBUG=False

# Security Configuration - حتماً تغییر دهید!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Logging Configuration
LOG_LEVEL=INFO

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
