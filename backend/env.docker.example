# Database Configuration for Docker Development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/forwarder_db

# CORS Configuration (allow frontend by IP e.g. http://130.185.77.25:8080)
CORS_ORIGIN=*
CORS_ALLOW_IP_ORIGINS=1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Security Configuration
SECRET_KEY=development-secret-key

# Logging Configuration
LOG_LEVEL=DEBUG

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
