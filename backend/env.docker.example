# Database Configuration for Docker Development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/forwarder_db

# CORS Configuration
CORS_ORIGIN=*

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Security Configuration
SECRET_KEY=development-secret-key

# Logging Configuration
LOG_LEVEL=DEBUG

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
