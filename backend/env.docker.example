# Docker development configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration for Docker Development
DATABASE_URL=postgresql+psycopg2://forwarder_dev:change_me@localhost:5432/forwarder_dev

# CORS Configuration for local frontend access
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=0

# Development-only Security Configuration
SECRET_KEY=dev-only-secret-key-change-before-production
JWT_SECRET_KEY=dev-only-jwt-secret-key-change-before-production

# Authentication session lifetimes (seconds)
ACCESS_TOKEN_LIFETIME_SECONDS=3600
REFRESH_IDLE_LIFETIME_SECONDS=2592000
SESSION_ABSOLUTE_LIFETIME_SECONDS=7776000
CLOCK_SKEW_SECONDS=60

# Logging Configuration
LOG_LEVEL=DEBUG

# SLA Configuration
SLA_HOURS=2

# Monitoring Configuration
ENABLE_MONITORING=True

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
# Migrations must run as an explicit deployment step before backend startup.
AUTO_MIGRATE_ON_STARTUP=false
DB_CONNECT_TIMEOUT_SECONDS=5
