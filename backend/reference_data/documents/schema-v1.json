{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forwarder.local/schemas/document-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_name", "catalog_version", "jurisdiction_bundle", "source_bundle_version", "checksum", "definitions"],
  "properties": {
    "schema_version": {"const": "1"},
    "catalog_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "jurisdiction_bundle": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_bundle_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "definitions": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {"$ref": "#/$defs/definition"}
    }
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"], "maxLength": 4000},
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name_fa", "name_en", "family", "description_fa", "description_en", "reference_number_label_fa", "reference_number_label_en", "expiry_applicable", "organization_overridable", "lifecycle_target", "source_review_status", "aliases", "jurisdictions", "transport_modes", "process_stages", "business_scopes", "provenance", "compatibility"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "name_fa": {"type": "string", "minLength": 1, "maxLength": 200},
        "name_en": {"type": "string", "minLength": 1, "maxLength": 200},
        "family": {"enum": ["COMMERCIAL", "TRANSPORT", "FORWARDING", "CUSTOMS", "WAREHOUSE", "RELEASE", "CERTIFICATE", "PERMIT_AUTHORIZATION", "INSURANCE", "FINANCE", "SAFETY", "OPERATIONAL_NOTICE"]},
        "description_fa": {"$ref": "#/$defs/nullableText"},
        "description_en": {"$ref": "#/$defs/nullableText"},
        "reference_number_label_fa": {"type": ["string", "null"], "maxLength": 160},
        "reference_number_label_en": {"type": ["string", "null"], "maxLength": 160},
        "expiry_applicable": {"type": ["boolean", "null"]},
        "organization_overridable": {"type": "boolean"},
        "lifecycle_target": {"enum": ["DRAFT", "REVIEWED", "SOURCE_CONFIRMED", "ACTIVE", "DEPRECATED"]},
        "source_review_status": {"enum": ["VERIFIED", "SOURCE_CONFIRMED", "SOURCE_CONFIRMATION_REQUIRED", "DOMAIN_CONFIRMATION_REQUIRED", "SUPERSEDED"]},
        "aliases": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/alias"}},
        "jurisdictions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/jurisdiction"}},
        "transport_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["ROAD", "SEA", "AIR", "RAIL", "MULTIMODAL", "MODE_INDEPENDENT"]}},
        "process_stages": {"type": "array", "uniqueItems": true, "items": {"enum": ["PRE_SHIPMENT", "BOOKING", "ORIGIN", "IN_TRANSIT", "ARRIVAL", "WAREHOUSE", "CUSTOMS_DECLARATION", "CUSTOMS_CLEARANCE", "RELEASE", "DELIVERY", "POST_DELIVERY", "PAYMENT_FINANCE"]}},
        "business_scopes": {"type": "array", "uniqueItems": true, "items": {"enum": ["REQUEST", "PROJECT", "OPERATIONAL_SHIPMENT", "CARGO", "MULTIPLE"]}},
        "provenance": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/provenance"}},
        "compatibility": {"$ref": "#/$defs/compatibility"}
      }
    },
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["locale", "display_value", "alias_kind"],
      "properties": {
        "locale": {"enum": ["fa", "en", "und"]},
        "display_value": {"type": "string", "minLength": 1, "maxLength": 200},
        "alias_kind": {"enum": ["ABBREVIATION", "TRANSLITERATION", "COMMON_NAME", "FORMER_NAME"]}
      }
    },
    "jurisdiction": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["GLOBAL", "INTERNATIONAL", "COUNTRY"]},
        "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "COUNTRY"}}}, "then": {"required": ["country_code"]}, "else": {"not": {"required": ["country_code"]}}}
      ]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_authority_code", "source_authority_name", "source_title", "source_reference", "source_url", "source_version", "source_date", "jurisdiction_key", "review_status", "notes"],
      "properties": {
        "source_authority_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "source_authority_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_title": {"type": "string", "minLength": 1, "maxLength": 300},
        "source_reference": {"type": ["string", "null"], "maxLength": 500},
        "source_url": {"type": ["string", "null"], "format": "uri", "maxLength": 500},
        "source_version": {"type": ["string", "null"], "maxLength": 100},
        "source_date": {"type": ["string", "null"], "format": "date"},
        "jurisdiction_key": {"type": ["string", "null"], "pattern": "^(GLOBAL|INTERNATIONAL|COUNTRY:[A-Z]{3})$"},
        "review_status": {"enum": ["VERIFIED", "SOURCE_CONFIRMED", "SOURCE_CONFIRMATION_REQUIRED", "DOMAIN_CONFIRMATION_REQUIRED", "SUPERSEDED"]},
        "notes": {"$ref": "#/$defs/nullableText"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "applicability_scope", "allowed_formats", "max_file_size_bytes", "max_active_file_count", "sort_order"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"$ref": "#/$defs/nullableText"},
        "applicability_scope": {"enum": ["all", "domestic", "international"]},
        "allowed_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["jpeg", "png", "webp", "pdf", "docx", "xlsx"]}},
        "max_file_size_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "max_active_file_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "sort_order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
