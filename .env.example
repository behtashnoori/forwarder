# Backend server (fixed port; do not auto-change if in use)
PORT=8000
# HOST=0.0.0.0 required for external/network access (127.0.0.1 would bind to localhost only)
HOST=0.0.0.0

# Postgres example
DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5432/forwarder_db

# CORS (comma-separated origins; used when frontend is not behind same-origin proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional: legacy / allow any origin
CORS_ORIGIN=http://localhost
# Set to 1 to allow any origin (needed when connecting from outside by IP, e.g. http://YOUR_SERVER_IP:8080)
CORS_ALLOW_ALL_ORIGINS=1

# SLA duration in hours
SLA_HOURS=2
