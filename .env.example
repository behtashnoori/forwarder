# Postgres example
DATABASE_URL=postgresql+psycopg2://postgres:password@127.0.0.1:5432/forwarder_db

# Backend: 0.0.0.0 = allow external access (default); use 127.0.0.1 only for strict local-only
# FLASK_RUN_HOST=0.0.0.0
# Forwarder backend port (default 5001 to avoid conflict with other app on 5000)
FLASK_RUN_PORT=5001

# Frontend: API base URL (must match backend port). In browser we use same host as page, so this is for build/SSR only.
VITE_API_URL=http://127.0.0.1:5001
# Optional: URL shown in frontend terminal for "from internet" (e.g. https://server.logisticmarket.ir)
# VITE_PUBLIC_APP_URL=https://server.logisticmarket.ir

# CORS: for external access (e.g. http://130.185.77.25:8080) keep CORS_ALLOW_IP_ORIGINS=1 (default) or set CORS_ORIGINS=http://130.185.77.25:8080
CORS_ORIGIN=http://localhost
# Set to 1 to allow any origin (useful for dev/external access)
# CORS_ALLOW_ALL_ORIGINS=0

# SLA duration in hours
SLA_HOURS=2
