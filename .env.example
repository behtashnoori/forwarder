# Safe local template. Copy manually with: npm run setup:env
# Replace change_me values only in the ignored local .env file.
# Production values must come from an approved secret manager or process environment.
FLASK_ENV=development
PORT=5001
HOST=0.0.0.0

DATABASE_URL=postgresql+psycopg2://forwarder_dev:change_me@localhost:5432/forwarder_dev
# TEST_DATABASE_URL=sqlite:///:memory:

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=0

SECRET_KEY=change_me_development_only
JWT_SECRET_KEY=change_me_development_only

SLA_HOURS=2
AUTO_MIGRATE_ON_STARTUP=false
DB_CONNECT_TIMEOUT_SECONDS=5
