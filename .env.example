# Runtime environment: development, testing, or production.
# Production requires DATABASE_URL, SECRET_KEY, JWT_SECRET_KEY, and CORS_ORIGINS.
FLASK_ENV=development

# Backend server (fixed port; do not auto-change if in use)
PORT=5001
# HOST=0.0.0.0 required for external/network access (127.0.0.1 would bind to localhost only)
HOST=0.0.0.0

# Development database. Put this file at the project root as .env.
# backend/.env is also supported for local developer convenience.
# If DATABASE_URL is already set in process env, it takes precedence.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/forwarder_db
# TEST_DATABASE_URL=sqlite:///:memory:

# Development/test CORS (comma-separated origins; production must use real HTTPS origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Development-only escape hatch. This is rejected when FLASK_ENV/APP_ENV/ENV is production.
CORS_ALLOW_ALL_ORIGINS=0

# Development-only secrets. Production must override both with deployment-specific values.
SECRET_KEY=dev-only-secret-key-change-before-production
JWT_SECRET_KEY=dev-only-jwt-secret-key-change-before-production

# SLA duration in hours
SLA_HOURS=2
# Database migrations are always explicit; startup rejects true.
AUTO_MIGRATE_ON_STARTUP=false
DB_CONNECT_TIMEOUT_SECONDS=5
