{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["dataset_id", "dataset_version", "manifest_sha256", "approval_status", "approved_by", "approved_at", "approval_reference", "approved_domains", "approved_operations", "limitations", "candidate_apply_authorized", "production_apply_authorized"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1}, "dataset_version": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_status": {"enum": ["draft", "under_review", "approved_for_validation", "approved_for_candidate_backfill", "approved_for_production_backfill", "rejected", "superseded"]},
    "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "approval_reference": {"type": "string", "minLength": 1},
    "approved_domains": {"type": "array", "items": {"enum": ["countries", "provinces", "counties", "cities", "ports", "port_locations", "port_coverage", "customs_offices", "port_customs_relationships", "customs_coverage"]}, "uniqueItems": true},
    "approved_operations": {"type": "array", "items": {"enum": ["assign_missing_identity", "assign_missing_parent", "create_port_location", "update_provenance", "validate_only"]}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}}, "candidate_apply_authorized": {"type": "boolean"}, "production_apply_authorized": {"type": "boolean"}
  }
}
