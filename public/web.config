<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Forwarder API reverse proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5101/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Forwarder SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules rewriteBeforeCache="true">
        <rule name="No-store application shell" preCondition="Successful HTML outside API">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <rule name="Application shell pragma" preCondition="Successful HTML outside API">
          <match serverVariable="RESPONSE_Pragma" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <rule name="Application shell expiry" preCondition="Successful HTML outside API">
          <match serverVariable="RESPONSE_Expires" pattern=".*" />
          <action type="Rewrite" value="0" />
        </rule>
        <rule name="Immutable hashed assets" preCondition="Successful hashed asset">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Revalidate unhashed application metadata" preCondition="Successful root metadata">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=0, must-revalidate" />
        </rule>
        <preConditions>
          <preCondition name="Successful HTML outside API">
            <add input="{RESPONSE_STATUS}" pattern="^200$" />
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html(?:;.*)?$" />
            <add input="{URL}" pattern="^/api(?:/|$)" negate="true" />
          </preCondition>
          <preCondition name="Successful hashed asset">
            <add input="{RESPONSE_STATUS}" pattern="^200$" />
            <add input="{URL}" pattern="^/assets/[^/?]+-[A-Za-z0-9_-]+\.(?:js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$" />
          </preCondition>
          <preCondition name="Successful root metadata">
            <add input="{RESPONSE_STATUS}" pattern="^200$" />
            <add input="{URL}" pattern="^/(?:site\.webmanifest|favicon\.ico|favicon-[^/]+\.png|apple-touch-icon\.png|brand-icon\.png)$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
